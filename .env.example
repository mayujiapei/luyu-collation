# 古籍智能校勘系统 — 环境变量样例
#
# 用法：复制为 .env 后填入真实密钥。.env 已在 .gitignore 中，永不提交。
#   cp .env.example .env
#
# 前端（Vite 只把 VITE_ 前缀的变量注入浏览器包，故密钥天然不进前端）
VITE_API_BASE=http://localhost:3001

# 后端监听端口（uvicorn 默认 3001，与 API.md 约定一致）
PORT=3001

# ---------------------------------------------------------------------------
# 大模型（必填一项即可：qwen 主用，deepseek 备用）
# LLM_PROVIDER 决定默认 LLM_BASE_URL / LLM_MODEL，可用后两项覆盖
# ---------------------------------------------------------------------------
LLM_PROVIDER=qwen
LLM_API_KEY=
# 留空则按 provider 取默认值：
#   qwen     -> https://dashscope.aliyuncs.com/compatible-mode/v1   (qwen-max)
#   deepseek -> https://api.deepseek.com/v1                          (deepseek-chat)
LLM_BASE_URL=
LLM_MODEL=

# ---------------------------------------------------------------------------
# OCR（F7 才需要，阶段一 R6 未实现，保持留空即可）
# ---------------------------------------------------------------------------
OCR_API_KEY=
OCR_SECRET_KEY=
